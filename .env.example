# Copy to .env. Every value below has a working default in src/signals/config.py,
# so an empty file still runs. Nothing secret is committed.

# --- database -----------------------------------------------------------
# Local development (no server needed):
DATABASE_URL=sqlite:///var/signals.db
# docker compose (this is what docker-compose.yml uses):
# DATABASE_URL=postgresql+psycopg://signals:signals@db:5432/signals
# Managed Postgres (Neon/Supabase/RDS):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# --- LLM classification -------------------------------------------------
# provider: openai | ollama | rules   (rules = free, offline, no API key)
LLM_PROVIDER=rules
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
CLASSIFY_PROMPT_VERSION=v1
LLM_MAX_CHARS=6000
LLM_TEMPERATURE=0.0

# --- ingestion ----------------------------------------------------------
HTTP_TIMEOUT=20
USER_AGENT=AutomotiveSignalsBot/0.1 (research prototype; contact you@example.com)
INGEST_MAX_ARTICLES_PER_SOURCE=40
INGEST_INTERVAL_MINUTES=60
CLASSIFY_INTERVAL_MINUTES=15
CLASSIFY_BATCH_SIZE=20

# --- api ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:8501
# Leave empty to disable auth (prototype). Set it before exposing the API.
API_TOKEN=

# --- dashboard ----------------------------------------------------------
# Only needed when the dashboard does not sit next to the API:
# API_URL=http://localhost:8000
# API_KEY=

# --- container entrypoint (docker-compose.yml) --------------------------
# Host ports; set these if 5432/8000/8501 are already taken locally.
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=8501
# The api container applies migrations and seeds the watchlist before serving.
# Set to 0 when migrations run in CI instead.
MIGRATE_ON_START=1
SEED_ON_START=1
